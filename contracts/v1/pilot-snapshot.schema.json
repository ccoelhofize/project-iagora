{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/pilot-snapshot.schema.json",
  "title": "IAgora bounded pilot snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "snapshot_id", "snapshot_version",
    "observation_cutoff", "generated_at", "territory", "programme",
    "campaign_commitment", "source_dataset", "case_studies",
    "publication_gate"
  ],
  "properties": {
    "contract_id": {"const": "iagora.pilot-snapshot"},
    "contract_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]},
    "snapshot_id": {"const": "pilot-respire-recre-2025"},
    "snapshot_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "observation_cutoff": {"const": "2025-12-31"},
    "generated_at": {"type": "string", "format": "date-time"},
    "territory": {"const": "fr-63113-clermont-ferrand"},
    "programme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programme_id", "name"],
      "properties": {
        "programme_id": {"const": "programme-respire-a-la-recre"},
        "name": {"const": "Respire à la récré"}
      }
    },
    "campaign_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_state", "fulfillment_conclusion", "blocking_reason"],
      "properties": {
        "verification_state": {
          "enum": ["primary_source_unverified", "primary_source_authenticated_with_limitations"]
        },
        "fulfillment_conclusion": {"const": "not_verifiable"},
        "blocking_reason": {
          "enum": [
            "primary_campaign_artifact_missing",
            "commitment_mapping_and_methodological_review_incomplete"
          ]
        }
      }
    },
    "campaign_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "artifact_version_id", "local_path", "sha256"],
      "properties": {
        "source_id": {"const": "src-campaign-2020-primary"},
        "artifact_version_id": {"type": "string", "minLength": 1},
        "local_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "commitment_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id", "mapping_version", "lifecycle_state", "local_path", "sha256"
      ],
      "properties": {
        "mapping_id": {"const": "mapping-campaign-schoolyards-to-respire-001"},
        "mapping_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "lifecycle_state": {"const": "proposed_review_pending"},
        "local_path": {"const": "data/pilot/commitment-mapping.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "administrative_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "bundle_version", "local_path", "sha256", "raw_bytes_preserved"],
      "properties": {
        "bundle_id": {"const": "administrative-evidence-respire-recre-2025"},
        "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "local_path": {"const": "data/pilot/administrative-evidence.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "raw_bytes_preserved": {"const": false}
      }
    },
    "source_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "artifact_id", "artifact_version_id", "local_path", "sha256", "acquired_at", "source_modified_at", "license_id", "raw_bytes_preserved"],
      "properties": {
        "source_id": {"const": "src-city-open-data-schools"},
        "artifact_id": {"const": "dataset-respire-enfants-vcf"},
        "artifact_version_id": {"type": "string", "minLength": 1},
        "local_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "acquired_at": {"type": "string", "format": "date-time"},
        "source_modified_at": {"type": "string", "format": "date-time"},
        "license_id": {"const": "etalab-2.0"},
        "raw_bytes_preserved": {"type": "boolean"},
        "raw_artifact_version_id": {"type": "string", "minLength": 1},
        "raw_local_path": {"type": "string", "minLength": 1},
        "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "raw_acquisition_event_path": {"type": "string", "minLength": 1}
      }
    },
    "case_studies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "school_name", "purpose"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^case-[a-z0-9-]+$"},
          "school_name": {"enum": ["Nestor-Perret", "Pierre-et-Marie-Curie", "Jean-Zay"]},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "publication_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "blockers"],
      "properties": {
        "eligible": {"const": false},
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
