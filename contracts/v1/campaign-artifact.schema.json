{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/campaign-artifact.schema.json",
  "title": "IAgora archived campaign artifact metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "artifact_id", "artifact_version_id",
    "source_id", "original_url", "archive_url", "archive_provider",
    "capture_at", "acquired_at", "media_type", "byte_size",
    "content_fingerprint_sha256", "raw_bytes_preserved",
    "nonretention_reason", "rights", "evidence_fragment", "authenticity"
  ],
  "properties": {
    "contract_id": {"const": "iagora.campaign-artifact"},
    "contract_version": {"const": "1.0.0"},
    "artifact_id": {"const": "campaign-naturellement-clermont-schoolyards"},
    "artifact_version_id": {"const": "campaign-naturellement-clermont-schoolyards-wayback-20191128144201"},
    "source_id": {"const": "src-campaign-2020-primary"},
    "original_url": {"type": "string", "format": "uri"},
    "archive_url": {"type": "string", "format": "uri"},
    "archive_provider": {"const": "Internet Archive Wayback Machine"},
    "capture_at": {"type": "string", "format": "date-time"},
    "acquired_at": {"type": "string", "format": "date-time"},
    "media_type": {"const": "text/html; charset=UTF-8"},
    "byte_size": {"type": "integer", "minimum": 1},
    "content_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_bytes_preserved": {"const": false},
    "nonretention_reason": {"const": "third_party_rights_block_public_repository_storage"},
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "redistribution", "notice_url", "review_state"],
      "properties": {
        "state": {"const": "restricted_by_archived_notice"},
        "redistribution": {"const": "blocked"},
        "notice_url": {"type": "string", "format": "uri"},
        "review_state": {"const": "qualified_review_pending"}
      }
    },
    "evidence_fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "locator", "quote", "language", "relationship"],
      "properties": {
        "evidence_id": {"const": "evidence-campaign-schoolyards-2020"},
        "locator": {"type": "string", "minLength": 1},
        "quote": {"const": "Végétalisation des cours d’école"},
        "language": {"const": "fr"},
        "relationship": {"const": "supports"}
      }
    },
    "authenticity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "basis", "limitations"],
      "properties": {
        "outcome": {"const": "authenticated_with_limitations"},
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
