{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/source-artifact-version.schema.json",
  "title": "IAgora source artifact version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "artifact_id", "artifact_version_id",
    "record_origin", "source_id", "sha256", "byte_size", "media_type",
    "acquisition_attempt_ids", "storage", "source_modified_at", "published_at",
    "rights", "access", "retention", "lifecycle_state", "supersedes",
    "possible_supersession_of", "raw_bytes_preserved", "non_retention_reason",
    "limitations"
  ],
  "properties": {
    "contract_id": {"const": "iagora.source-artifact-version"},
    "contract_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9-]+$"},
    "artifact_version_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "record_origin": {"enum": ["live_execution", "offline_replay", "retrospective_compatibility_fixture"]},
    "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1},
    "media_type": {"type": "string", "minLength": 1},
    "acquisition_attempt_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^attempt-[a-z0-9-]+$"}
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_state", "storage_reference", "content_addressed"],
      "properties": {
        "storage_state": {"enum": ["retained_repository", "temporary_package", "not_retained"]},
        "storage_reference": {"type": ["string", "null"]},
        "content_addressed": {"type": "boolean"}
      }
    },
    "source_modified_at": {"type": ["string", "null"], "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_id", "redistribution"],
      "properties": {
        "license_id": {"type": ["string", "null"]},
        "redistribution": {"enum": ["allowed_with_attribution", "blocked"]}
      }
    },
    "access": {"enum": ["public_unauthenticated", "restricted"]},
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_class", "retention_state"],
      "properties": {
        "retention_class": {"type": "string", "minLength": 1},
        "retention_state": {"enum": ["active", "temporary", "removed", "blocked"]}
      }
    },
    "lifecycle_state": {"enum": ["quarantined", "admitted", "superseded", "rejected", "removed"]},
    "supersedes": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"},
    "possible_supersession_of": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"},
    "raw_bytes_preserved": {"type": "boolean"},
    "non_retention_reason": {"type": ["string", "null"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
