{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/knowledge-passport.schema.json",
  "title": "IAgora Knowledge Passport prototype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "passport_id", "passport_version",
    "asset", "scope", "assertion", "authority", "evidence", "provenance",
    "lineage", "quality", "conflicts_and_uncertainty", "rights", "review",
    "accessibility", "case_studies", "publication"
  ],
  "properties": {
    "contract_id": {"const": "iagora.knowledge-passport"},
    "contract_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "passport_id": {"type": "string", "pattern": "^passport-[a-z0-9-]+$"},
    "passport_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_type", "asset_version", "lifecycle_state", "plain_language_description"],
      "properties": {
        "asset_id": {"const": "pilot-respire-recre-2025"},
        "asset_type": {"const": "pilot_assessment_snapshot"},
        "asset_version": {"type": "string"},
        "lifecycle_state": {"const": "internal_prototype"},
        "plain_language_description": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["territory", "institution", "period_start", "observation_cutoff", "population"],
      "properties": {
        "territory": {"const": "fr-63113-clermont-ferrand"},
        "institution": {"const": "Ville de Clermont-Ferrand"},
        "period_start": {"const": "2021-01-01"},
        "observation_cutoff": {"const": "2025-12-31"},
        "population": {"const": "three selected public-school case studies"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemic_kind", "statement", "fulfillment_conclusion", "causal_claim_class"],
      "properties": {
        "epistemic_kind": {"const": "methodological_inference"},
        "statement": {"type": "string", "minLength": 1},
        "fulfillment_conclusion": {"const": "not_verifiable"},
        "causal_claim_class": {"const": "causal_status_not_verifiable"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_type", "rule_version", "outcome", "rationale", "limitations"],
      "properties": {
        "fact_type": {"const": "reported_output_or_completion"},
        "rule_version": {"const": "adr-0003-1.0"},
        "outcome": {"const": "authoritative_with_limitation"},
        "rationale": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "campaign_commitment": {"type": "object"}
      }
    },
    "campaign_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_state", "wording", "source_scope", "quantification_state",
        "mapping_state", "artifact_version_id", "evidence_id"
      ],
      "properties": {
        "verification_state": {"const": "primary_source_authenticated_with_limitations"},
        "wording": {"const": "Végétalisation des cours d’école"},
        "source_scope": {"const": "Clermont-Ferrand municipal campaign"},
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor", "campaign_list", "election_context", "territory"],
          "properties": {
            "actor": {"const": "Olivier Bianchi"},
            "campaign_list": {"const": "Naturellement Clermont"},
            "election_context": {"const": "2020 Clermont-Ferrand municipal election"},
            "territory": {"const": "fr-63113-clermont-ferrand"}
          }
        },
        "specificity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity_state", "deadline_state", "budget_state",
            "broader_geographic_claim_state"
          ],
          "properties": {
            "quantity_state": {"const": "not_stated"},
            "deadline_state": {"const": "not_stated"},
            "budget_state": {"const": "not_stated"},
            "broader_geographic_claim_state": {"const": "absent_from_primary_fragment"}
          }
        },
        "scope_limits": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "quantification_state": {"const": "unquantified_in_primary_fragment"},
        "mapping_state": {"const": "review_incomplete"},
        "mapping_evidence_state": {"const": "candidate_evidence_found"},
        "artifact_version_id": {"type": "string", "minLength": 1},
        "evidence_id": {"const": "evidence-campaign-schoolyards-2020"}
      }
    },
    "commitment_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id", "mapping_version", "lifecycle_state", "method_id",
        "method_version", "proposal_origin", "review_state", "relationship_role",
        "candidate_conclusion", "target_programme_id", "target_programme_name",
        "component", "scope_comparison", "rationale", "uncertainty",
        "limitations", "fulfillment_conclusion", "prohibited_inferences"
      ],
      "properties": {
        "mapping_id": {"const": "mapping-campaign-schoolyards-to-respire-001"},
        "mapping_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "lifecycle_state": {"const": "proposed_review_pending"},
        "method_id": {"const": "iagora.commitment-mapping"},
        "method_version": {"const": "adr-0004-1.0"},
        "proposal_origin": {"const": "ai_assisted"},
        "review_state": {"const": "pending_independent_methodological_review"},
        "relationship_role": {"const": "implements"},
        "candidate_conclusion": {"const": "candidate_evidence_found_review_incomplete"},
        "target_programme_id": {"const": "programme-respire-a-la-recre"},
        "target_programme_name": {"const": "Respire à la récré"},
        "component": {"type": "object"},
        "scope_comparison": {"type": "array", "minItems": 5, "items": {"type": "object"}},
        "rationale": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fulfillment_conclusion": {"const": "not_verifiable"},
        "prohibited_inferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "administrative_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_version", "commitment_mapping", "policy_adoption",
        "budget_authorization", "executed_expenditure", "procurement",
        "competent_completion", "outcome_evidence", "causal_impact",
        "fulfillment_conclusion", "financial_distinctions",
        "procurement_searches", "procurement_records", "milestones"
      ],
      "properties": {
        "rule_version": {"const": "adr-0003-and-adr-0004-1.0"},
        "commitment_mapping": {"const": "candidate_evidence_found_review_incomplete"},
        "policy_adoption": {"const": "evidenced"},
        "budget_authorization": {"const": "evidenced_at_programme_level"},
        "executed_expenditure": {"const": "evidenced_at_programme_level"},
        "procurement": {"enum": ["not_located", "partial_candidate_services_evidence"]},
        "competent_completion": {"const": "not_located"},
        "outcome_evidence": {"const": "missing"},
        "causal_impact": {"const": "missing"},
        "fulfillment_conclusion": {"const": "not_verifiable"},
        "financial_distinctions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "procurement_searches": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "procurement_records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "milestones": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "relationship", "artifact_version_id", "locator", "source_url"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9-]+$"},
          "relationship": {"enum": ["supports", "contradicts", "contextualizes"]},
          "artifact_version_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"}
        }
      }
    },
    "provenance": {"type": "object"},
    "lineage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "quality": {"type": "object"},
    "conflicts_and_uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rights": {"type": "object"},
    "review": {"type": "object"},
    "accessibility": {"type": "object"},
    "case_studies": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "blockers"],
      "properties": {
        "eligible": {"const": false},
        "blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
