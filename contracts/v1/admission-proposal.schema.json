{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/admission-proposal.schema.json",
  "title": "IAgora protected remote admission proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "proposal_id", "record_origin",
    "repository", "receipt_issue_number", "receipt_sha256", "prepared_at",
    "decision", "rationale", "reviewer_role", "package_reference",
    "package_manifest_sha256", "attempt_id", "artifact_version_id",
    "plan_reference", "source_profile_reference", "candidate", "target_files",
    "admission_review_id", "publication_authorized", "automatic_merge_allowed",
    "limitations"
  ],
  "properties": {
    "contract_id": {"const": "iagora.admission-proposal"},
    "contract_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "pattern": "^admission-proposal-[a-z0-9-]+$"},
    "record_origin": {"enum": ["live_execution", "synthetic_non_civic_fixture"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "receipt_issue_number": {"type": "integer", "minimum": 1},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["admit", "reject"]},
    "rationale": {"type": "string", "minLength": 10},
    "reviewer_role": {"const": "maintainer"},
    "package_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "workflow_run_id", "created_at", "expires_at"],
      "properties": {
        "package_id": {"type": "string", "pattern": "^package-[a-z0-9-]+$"},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "package_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt_id": {"type": "string", "pattern": "^attempt-[a-z0-9-]+$"},
    "artifact_version_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "plan_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_version", "plan_sha256"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9-]+$"},
        "plan_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_profile_version"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
        "source_profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_size", "media_type", "record_count"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1},
        "media_type": {"enum": ["application/json", "application/json; charset=utf-8"]},
        "record_count": {"type": "integer", "minimum": 1}
      }
    },
    "target_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byte_size", "content_role"],
        "properties": {
          "path": {"type": "string", "pattern": "^(data/raw/respire-a-la-recre|data/acquisition/admissions)/[a-zA-Z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "byte_size": {"type": "integer", "minimum": 1},
          "content_role": {"enum": ["candidate_raw_bytes", "acquisition_event", "source_change_report"]}
        }
      }
    },
    "admission_review_id": {"type": "string", "pattern": "^admission-review-[a-z0-9-]+$"},
    "publication_authorized": {"const": false},
    "automatic_merge_allowed": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
