{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/administrative-evidence.schema.json",
  "title": "IAgora bounded administrative evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "bundle_id", "bundle_version",
    "observation_cutoff", "assembled_at", "territory",
    "raw_bytes_preserved", "documents", "procurement_searches",
    "chain_summary"
  ],
  "properties": {
    "contract_id": {"const": "iagora.administrative-evidence"},
    "contract_version": {"const": "1.0.0"},
    "bundle_id": {"const": "administrative-evidence-respire-recre-2025"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "observation_cutoff": {"const": "2025-12-31"},
    "assembled_at": {"type": "string", "format": "date-time"},
    "territory": {"const": "fr-63113-clermont-ferrand"},
    "raw_bytes_preserved": {"const": false},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_version_id", "source_id", "title", "publisher",
          "canonical_url", "issued_at", "document_role", "scope",
          "acquisition", "rights", "authority", "evidence_fragments"
        ],
        "properties": {
          "artifact_version_id": {"type": "string", "pattern": "^artifact-[a-z0-9-]+$"},
          "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"const": "Ville de Clermont-Ferrand"},
          "canonical_url": {"type": "string", "format": "uri"},
          "issued_at": {"type": "string", "format": "date"},
          "document_role": {
            "enum": [
              "final_deliberation", "adopted_annex", "budget_annex",
              "approved_account", "administrative_report",
              "official_communication", "funding_plan",
              "publication_attestation"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "ids"],
            "properties": {
              "level": {"enum": ["programme", "school_case"]},
              "ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "acquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "acquired_at", "media_type", "byte_size", "sha256",
              "raw_bytes_preserved", "nonretention_reason"
            ],
            "properties": {
              "acquired_at": {"type": "string", "format": "date-time"},
              "media_type": {"const": "application/pdf"},
              "byte_size": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "raw_bytes_preserved": {"const": false},
              "nonretention_reason": {"const": "third_party_rights_and_privacy_review_pending"}
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "redistribution", "notice_url", "review_state"],
            "properties": {
              "state": {"const": "rights_review_pending"},
              "redistribution": {"const": "blocked"},
              "notice_url": {"type": "string", "format": "uri"},
              "review_state": {"const": "qualified_review_pending"}
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_type", "outcome", "basis", "limitations"],
            "properties": {
              "fact_type": {
                "enum": [
                  "adopted_policy", "budget_amendment",
                  "initial_budget_authorization", "executed_expenditure",
                  "reported_output_or_completion", "funding_forecast",
                  "publication_event"
                ]
              },
              "outcome": {
                "enum": ["authoritative", "authoritative_with_limitation", "not_authoritative"]
              },
              "basis": {"type": "string", "minLength": 1},
              "limitations": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "evidence_fragments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "relationship", "locator", "statement", "stage"],
              "properties": {
                "evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9-]+$"},
                "relationship": {"enum": ["supports", "contextualizes"]},
                "locator": {"type": "string", "minLength": 1},
                "statement": {"type": "string", "minLength": 1},
                "stage": {
                  "enum": [
                    "adopted_policy", "budget_authorization",
                    "executed_expenditure", "reported_delivery",
                    "funding_forecast", "publication_only"
                  ]
                },
                "amount": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "currency", "tax_basis", "financial_stage", "scope"],
                  "properties": {
                    "value": {"type": "number", "minimum": 0},
                    "currency": {"const": "EUR"},
                    "tax_basis": {"enum": ["HT", "TTC", "not_stated"]},
                    "financial_stage": {
                      "enum": [
                        "authorized_programme", "authorized_annual",
                        "executed_annual", "executed_cumulative",
                        "reported_site_cost", "forecast_site_cost",
                        "reported_subsidy_amount"
                      ]
                    },
                    "scope": {"enum": ["programme", "school_case"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "procurement_searches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "search_id", "searched_at", "method", "source_urls",
          "query_scope", "outcome", "interpretation", "limitations"
        ],
        "properties": {
          "search_id": {"type": "string", "pattern": "^search-[a-z0-9-]+$"},
          "searched_at": {"type": "string", "format": "date-time"},
          "method": {"type": "string", "minLength": 1},
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uri"}
          },
          "query_scope": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["no_matching_record_returned", "no_unambiguous_record_identified"]},
          "interpretation": {"const": "not_evidence_of_absence"},
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "chain_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment_mapping", "policy_adoption", "budget_authorization",
        "executed_expenditure", "procurement", "competent_completion",
        "outcome_evidence", "causal_impact", "fulfillment_conclusion"
      ],
      "properties": {
        "commitment_mapping": {"const": "candidate_evidence_found_review_incomplete"},
        "policy_adoption": {"const": "evidenced"},
        "budget_authorization": {"const": "evidenced_at_programme_level"},
        "executed_expenditure": {"const": "evidenced_at_programme_level"},
        "procurement": {"const": "not_located"},
        "competent_completion": {"const": "not_located"},
        "outcome_evidence": {"const": "missing"},
        "causal_impact": {"const": "missing"},
        "fulfillment_conclusion": {"const": "not_verifiable"}
      }
    }
  }
}
