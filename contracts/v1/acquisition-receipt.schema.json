{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/acquisition-receipt.schema.json",
  "title": "IAgora safe acquisition attempt receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "receipt_id", "record_origin",
    "attempt_id", "package_id", "workflow_run_id", "plan_reference",
    "source_profile_reference", "attempted_at", "safe_outcome", "media_type",
    "byte_size", "sha256", "policy_states", "package_created_at",
    "reminder_due_at", "package_expires_at", "extension_count", "review_state",
    "decision_at", "decision_rationale", "admission_review_id", "pull_request_url",
    "bytes_available", "limitations"
  ],
  "properties": {
    "contract_id": {"const": "iagora.acquisition-receipt"},
    "contract_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^receipt-[a-z0-9-]+$"},
    "record_origin": {"enum": ["live_execution", "retrospective_compatibility_fixture"]},
    "attempt_id": {"type": "string", "pattern": "^attempt-[a-z0-9-]+$"},
    "package_id": {"type": ["string", "null"], "pattern": "^package-[a-z0-9-]+$"},
    "workflow_run_id": {"type": ["string", "null"]},
    "plan_reference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["plan_id", "plan_version"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9-]+$"},
        "plan_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "source_profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_profile_version"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
        "source_profile_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "attempted_at": {"type": "string", "format": "date-time"},
    "safe_outcome": {"enum": ["unchanged", "candidate_new_version", "quarantined_validation_failure", "blocked_by_policy", "transport_failure"]},
    "media_type": {"type": ["string", "null"]},
    "byte_size": {"type": ["integer", "null"], "minimum": 0},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "policy_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation", "rights", "privacy", "security", "retention"],
      "properties": {
        "validation": {"enum": ["passed", "failed", "not_run"]},
        "rights": {"enum": ["passed", "blocked", "not_run"]},
        "privacy": {"enum": ["passed", "blocked", "not_run"]},
        "security": {"enum": ["passed", "blocked", "not_run"]},
        "retention": {"enum": ["passed", "blocked", "not_run"]}
      }
    },
    "package_created_at": {"type": ["string", "null"], "format": "date-time"},
    "reminder_due_at": {"type": ["string", "null"], "format": "date-time"},
    "package_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "extension_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "review_state": {"enum": ["admission_pending", "admitted", "rejected", "extended", "expired_without_admission"]},
    "decision_at": {"type": ["string", "null"], "format": "date-time"},
    "decision_rationale": {"type": ["string", "null"]},
    "admission_review_id": {"type": ["string", "null"], "pattern": "^admission-review-[a-z0-9-]+$"},
    "pull_request_url": {"type": ["string", "null"], "format": "uri"},
    "bytes_available": {"type": "boolean"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
