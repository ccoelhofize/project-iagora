{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/acquisition-plan.schema.json",
  "title": "IAgora governed acquisition plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "plan_id", "plan_version",
    "lifecycle_state", "source_profile_reference", "connector", "purpose",
    "territory", "observation_scope", "query", "transport_policy",
    "policy_gates", "admission_policy", "review", "limitations"
  ],
  "properties": {
    "contract_id": {"const": "iagora.acquisition-plan"},
    "contract_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9-]+$"},
    "plan_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "lifecycle_state": {"enum": ["draft_review_pending", "approved_prototype", "suspended"]},
    "source_profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_profile_version"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
        "source_profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_type", "connector_rule_version", "dataset_id"],
      "properties": {
        "connector_type": {"enum": ["opendatasoft_explore_v2_json"]},
        "connector_rule_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "dataset_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "territory": {"type": "string", "pattern": "^fr-[a-z0-9-]+$"},
    "observation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "identity_field", "identity_values"],
      "properties": {
        "scope_type": {"enum": ["bounded_school_units"]},
        "identity_field": {"const": "uai"},
        "identity_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^063[0-9A-Z]{5}$"}
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_fields", "filter_operator", "order_by", "result_limit"],
      "properties": {
        "selected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        },
        "filter_operator": {"const": "identity_in_reviewed_set"},
        "order_by": {"const": "uai"},
        "result_limit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "transport_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme", "allowed_host", "endpoint_path", "authentication_class",
        "expected_media_types", "timeout_seconds", "maximum_response_bytes",
        "maximum_accepted_records", "maximum_redirects", "maximum_attempts"
      ],
      "properties": {
        "scheme": {"const": "https"},
        "allowed_host": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "endpoint_path": {"type": "string", "pattern": "^/api/explore/v2\\.1/catalog/datasets/[a-z0-9-]+/records$"},
        "authentication_class": {"const": "public_unauthenticated"},
        "expected_media_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["application/json", "application/json; charset=utf-8"]}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "maximum_response_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_accepted_records": {"type": "integer", "minimum": 1, "maximum": 100},
        "maximum_redirects": {"type": "integer", "minimum": 0, "maximum": 5},
        "maximum_attempts": {"const": 1}
      }
    },
    "policy_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights", "privacy", "security", "retention"],
      "properties": {
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_state", "license_id", "redistribution"],
          "properties": {
            "required_state": {"const": "open_license"},
            "license_id": {"const": "etalab-2.0"},
            "redistribution": {"const": "allowed_with_attribution"}
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "personal_data_expected", "child_data_allowed", "excluded_field_classes"],
          "properties": {
            "classification": {"const": "public_non_personal"},
            "personal_data_expected": {"const": false},
            "child_data_allowed": {"const": false},
            "excluded_field_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["coordinates", "images", "free_text", "contact_data", "child_level_data"]}
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_tier", "remote_content_untrusted", "arbitrary_url_allowed"],
          "properties": {
            "risk_tier": {"const": "low"},
            "remote_content_untrusted": {"const": true},
            "arbitrary_url_allowed": {"const": false}
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retention_class", "temporary_package_days", "reminder_day", "maximum_extensions"],
          "properties": {
            "retention_class": {"const": "open_data_prototype"},
            "temporary_package_days": {"const": 14},
            "reminder_day": {"const": 10},
            "maximum_extensions": {"const": 1}
          }
        }
      }
    },
    "admission_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_review_required", "direct_main_write_allowed", "automatic_merge_allowed", "publication_authorized"],
      "properties": {
        "human_review_required": {"const": true},
        "direct_main_write_allowed": {"const": false},
        "automatic_merge_allowed": {"const": false},
        "publication_authorized": {"const": false}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_state", "reviewer_role", "reviewed_at", "suspension_conditions"],
      "properties": {
        "review_state": {"enum": ["pending", "approved_for_bounded_prototype"]},
        "reviewer_role": {"const": "maintainer"},
        "reviewed_at": {"type": "string", "format": "date"},
        "suspension_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
