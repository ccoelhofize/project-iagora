{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-iagora.example/contracts/v1/remote-acquisition-package.schema.json",
  "title": "IAgora temporary remote acquisition package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_version", "package_id", "workflow_run_id",
    "created_at", "expires_at", "plan_reference", "source_profile_reference",
    "attempt_id", "outcome", "review_state", "artifact_version_id",
    "component_files", "raw_bytes_included", "admission_state",
    "publication_authorized", "limitations"
  ],
  "properties": {
    "contract_id": {"const": "iagora.remote-acquisition-package"},
    "contract_version": {"const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^package-[a-z0-9-]+$"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "plan_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_version", "plan_sha256"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9-]+$"},
        "plan_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_profile_version"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
        "source_profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "attempt_id": {"type": "string", "pattern": "^attempt-[a-z0-9-]+$"},
    "outcome": {"enum": ["unchanged", "candidate_new_version", "quarantined_validation_failure", "blocked_by_policy", "transport_failure"]},
    "review_state": {"enum": ["not_reviewable", "no_admission_required", "admission_pending"]},
    "artifact_version_id": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"},
    "component_files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byte_size", "content_role"],
        "properties": {
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "byte_size": {"type": "integer", "minimum": 1},
          "content_role": {"enum": ["attempt_metadata", "artifact_metadata", "change_report", "candidate_raw_bytes", "safe_summary", "receipt"]}
        }
      }
    },
    "raw_bytes_included": {"type": "boolean"},
    "admission_state": {"const": "not_admitted"},
    "publication_authorized": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
